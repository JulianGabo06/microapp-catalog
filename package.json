{
  "name": "microapp-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "Micro app Catalog (Module Federation remote) para el host MicroApps",
  "main": "index.js",
  "scripts": {
    "start": "react-native start --port 9001",
    "typecheck": "node scripts/typecheck.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm test && npm run lint",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js"
  },
  "dependencies": {
    "@microapps/uniwind-rspack": "file:../MicroApps/packages/uniwind-rspack",
    "@module-federation/enhanced": "2.5.0",
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "2.3.11",
    "@callstack/repack": "5.2.5",
    "@callstack/repack-plugin-expo-modules": "5.2.5",
    "@changesets/cli": "^3.0.3",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@rspack/core": "^1.4.11",
    "@swc/core": "^1.11.24",
    "@swc/helpers": "0.5.17",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "test-renderer": "~1.2.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "test-renderer": "~1.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
